{
  "name": "dsh-plugin-jira",
  "version": "0.1.2",
  "description": "Jira ticket intake for DeepSeek Harness: settings page for the API token, /jira-do command that branches off dev and hands the ticket to the agent, /jira-comment plus jira_ticket and jira_comment tools",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "Angelo Madara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelomadara/dsh-plugin-jira.git"
  },
  "homepage": "https://github.com/angelomadara/dsh-plugin-jira#readme",
  "bugs": {
    "url": "https://github.com/angelomadara/dsh-plugin-jira/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jira",
    "atlassian",
    "cordis"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
